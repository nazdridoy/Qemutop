class SelfTest:
    """
    Validates core /proc parsing and metric calculation logic.
    Does not require real QEMU processes.
    """

    PASS = "\033[32mPASS\033[0m"
    FAIL = "\033[31mFAIL\033[0m"

    def __init__(self) -> None:
        self.passed = 0
        self.failed = 0

    def check(self, name: str, condition: bool, detail: str = "") -> None:
        if condition:
            print(f"  [{self.PASS}] {name}")
            self.passed += 1
        else:
            print(f"  [{self.FAIL}] {name}" + (f": {detail}" if detail else ""))
            self.failed += 1

    def run(self) -> int:
        print(f"\nqemu-top v{VERSION} self-test\n")

        self._test_name_resolution()
        self._test_uptime_format()
        self._test_memory_format()
        self._test_bytes_format()
        self._test_cpu_calculation()
        self._test_proc_stat_parsing()
        self._test_proc_status_parsing()
        self._test_io_parsing()
        self._test_cmdline_net_parsing()
        self._test_discovery_regex()
        self._test_host_mem()
        self._test_host_uptime()

        print(f"\nResults: {self.passed} passed, {self.failed} failed\n")
        return 0 if self.failed == 0 else 1

    def _test_name_resolution(self) -> None:
        print("Name Resolution:")
        cases = [
            (["qemu-system-x86_64", "-name", "win11"], "win11"),
            (["qemu-system-x86_64", "-name", "guest=ubuntu,debug-threads=on"], "ubuntu"),
            (["qemu-system-x86_64", "-m", "2048"], "qemu-9999"),
            (["qemu-system-x86_64", "-name", "my-vm,debug-threads=on"], "my-vm"),
        ]
        for cmdline, expected in cases:
            result = resolve_vm_name(cmdline, 9999)
            self.check(f"resolve_vm_name({cmdline[-1] if len(cmdline) > 1 else 'fallback'})",
                       result == expected,
                       f"got '{result}', expected '{expected}'")

    def _test_uptime_format(self) -> None:
        print("\nUptime Formatting:")
        cases = [
            (45, "45s"),
            (754, "12m34s"),
            (12060, "3h21m"),
            (187200, "2d04h"),
        ]
        for sec, expected in cases:
            result = fmt_uptime(sec)
            self.check(f"fmt_uptime({sec})", result == expected,
                       f"got '{result}', expected '{expected}'")

    def _test_memory_format(self) -> None:
        print("\nMemory Formatting:")
        cases = [
            (512, "512 KiB"),
            (2048, "2.00 MiB"),
            (1048576, "1.00 GiB"),
            (6553600, "6.25 GiB"),
        ]
        for kib, expected in cases:
            result = fmt_mem(kib)
            self.check(f"fmt_mem({kib})", result == expected,
                       f"got '{result}', expected '{expected}'")

    def _test_bytes_format(self) -> None:
        print("\nBytes Rate Formatting:")
        # Just check it doesn't crash and returns a string
        for b in (0.0, 512.0, 1024.0 * 12.4, 1024.0 * 1024.0 * 3.2, None):
            result = fmt_bytes(b)
            self.check(f"fmt_bytes({b})", isinstance(result, str))

    def _test_cpu_calculation(self) -> None:
        print("\nCPU Calculation:")
        # Simulate: 200 ticks in 1 second = 200% (2 full CPUs)
        tick_delta = 200
        dt = 1.0
        clk = CLK_TCK  # e.g. 100
        cpu_pct = (tick_delta / clk) / dt * 100.0
        self.check("CPU delta calculation (200 ticks/s @ 100Hz = 200%)",
                   abs(cpu_pct - 200.0) < 0.01,
                   f"got {cpu_pct}")

        # Zero delta = 0%
        cpu_zero = (0 / clk) / 1.0 * 100.0
        self.check("CPU delta calculation (0 ticks = 0%)",
                   cpu_zero == 0.0)

    def _test_proc_stat_parsing(self) -> None:
        print("\n/proc/<pid>/stat Parsing:")
        # Synthesize a realistic /proc/stat line
        # Format: pid (name) state ppid ... utime stime ... starttime ...
        # We'll build a minimal line: fields after ')' at positions 11 and 12 are utime/stime,
        # position 19 is starttime (0-indexed after rparen).
        fields_after = ["S", "1", "4217", "4217", "0", "0", "0", "0", "0", "0", "0",
                        "12345",  # utime  → index 11
                        "6789",   # stime  → index 12
                        "0", "0", "0", "0", "0", "0",
                        "987654", # starttime → index 19
                        ]
        fake_stat = f"4217 (qemu-system-x86_64) {' '.join(fields_after)}"

        # Parse using the same logic as ProcCollector._read_stat
        rparen = fake_stat.rfind(")")
        f = fake_stat[rparen + 2:].split()
        utime = int(f[11])
        stime = int(f[12])
        starttime = int(f[19])
        self.check("utime parsed correctly", utime == 12345, str(utime))
        self.check("stime parsed correctly", stime == 6789, str(stime))
        self.check("starttime parsed correctly", starttime == 987654, str(starttime))
        self.check("cpu_ticks sum", utime + stime == 19134)

    def _test_proc_status_parsing(self) -> None:
        print("\n/proc/<pid>/status Parsing:")
        fake_status = (
            "Name:\tqemu-system-x86_64\n"
            "VmSize:\t 8529920 kB\n"
            "VmRSS:\t  6621184 kB\n"
            "Threads:\t16\n"
        )
        rss = vsz = 0
        for line in fake_status.splitlines():
            if line.startswith("VmRSS:"):
                rss = int(line.split()[1])
            elif line.startswith("VmSize:"):
                vsz = int(line.split()[1])
        self.check("VmRSS parsed", rss == 6621184, str(rss))
        self.check("VmSize parsed", vsz == 8529920, str(vsz))

    def _test_io_parsing(self) -> None:
        print("\n/proc/<pid>/io Parsing:")
        fake_io = (
            "rchar: 18446744073709551615\n"
            "wchar: 8765432\n"
            "syscr: 1234\n"
            "syscw: 567\n"
            "read_bytes: 193273856\n"
            "write_bytes: 43827200\n"
            "cancelled_write_bytes: 0\n"
        )
        rb = wb = 0
        for line in fake_io.splitlines():
            if line.startswith("read_bytes:"):
                rb = int(line.split()[1])
            elif line.startswith("write_bytes:"):
                wb = int(line.split()[1])
        self.check("read_bytes parsed", rb == 193273856, str(rb))
        self.check("write_bytes parsed", wb == 43827200, str(wb))

    def _test_cmdline_net_parsing(self) -> None:
        print("\nNetwork Interface Parsing:")
        nc = NetworkCollector()
        cases = [
            (
                ["qemu-system-x86_64", "-netdev", "tap,id=net0,ifname=tap0,script=no"],
                ["tap0"],
            ),
            (
                ["qemu-system-x86_64", "-net", "tap,ifname=vnet3"],
                ["vnet3"],
            ),
            (
                ["qemu-system-x86_64", "-m", "2048"],
                [],
            ),
            (
                ["qemu-system-x86_64", "-netdev",
                 "tap,id=net0,ifname=tap0", "-netdev", "tap,id=net1,ifname=tap1"],
                ["tap0", "tap1"],
            ),
        ]
        for cmdline, expected in cases:
            result = nc._parse_cmdline_interfaces(cmdline)
            self.check(f"cmdline ifname parse ({cmdline[-1]})",
                       result == expected,
                       f"got {result}, expected {expected}")

    def _test_discovery_regex(self) -> None:
        print("\nProcess Discovery Regex:")
        cases = [
            ("qemu-system-x86_64", True),
            ("qemu-system-aarch64", True),
            ("qemu-system-riscv64", True),
            ("qemu-system-arm", True),
            ("bash", False),
            ("python3", False),
            ("qemu-img", False),
        ]
        for name, expected in cases:
            result = bool(QEMU_RE.search(name))
            self.check(f"QEMU_RE.search('{name}')", result == expected)

    def _test_host_mem(self) -> None:
        print("\nHost Memory:")
        used, total = get_host_mem()
        self.check("/proc/meminfo readable", total > 0, f"total={total}")
        self.check("used <= total", used <= total, f"used={used} total={total}")

    def _test_host_uptime(self) -> None:
        print("\nHost Uptime:")
        uptime = get_host_uptime()
        self.check("/proc/uptime readable", uptime > 0, f"uptime={uptime}")


