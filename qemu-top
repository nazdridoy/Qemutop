def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "htop-style live resource monitor for QEMU/KVM virtual machines.\n"
            "Discovers VMs directly from /proc — no libvirt required."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
Keyboard Controls (TUI):
  q / Ctrl-C   quit
  f            force refresh
  + / -        increase/decrease refresh interval
  ↑ / ↓        navigate VM list
  Enter / d    VM detail view
  l            full command line view
  Esc          return to main view
  c            sort by CPU
  m            sort by RAM
  r            sort by disk read
  w            sort by disk write
  n            sort by net RX
  t            sort by net TX
  N            sort by name
  p            sort by PID
  u            sort by uptime

Examples:
  %(prog)s
  %(prog)s -i 1
  %(prog)s --interval 5
  %(prog)s --once
  %(prog)s --once --sort memory
  %(prog)s --no-color
  %(prog)s --self-test
        """,
    )
    parser.add_argument(
        "-i", "--interval",
        type=float,
        default=2.0,
        metavar="SECONDS",
        help="refresh interval in seconds (default: 2.0, min: 0.5)",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="print one snapshot table to stdout and exit",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="disable color output",
    )
    parser.add_argument(
        "--sort",
        choices=list(SORT_KEYS),
        default="cpu",
        metavar="KEY",
        help=(
            "initial sort column: cpu, ram, read, write, netrx, nettx, "
            "name, pid, uptime (default: cpu)"
        ),
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="run built-in self-tests and exit",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}",
    )
    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    # Validate interval
    if args.interval < MIN_INTERVAL:
        parser.error(f"--interval must be >= {MIN_INTERVAL}")
    if args.interval > MAX_INTERVAL:
        parser.error(f"--interval must be <= {MAX_INTERVAL}")

    if args.self_test:
        st = SelfTest()
        sys.exit(st.run())

    app = QemuTop(
        interval=args.interval,
        use_color=not args.no_color,
        sort_key=args.sort,
    )

    if args.once:
        app.run_once(args.sort)
    else:
        try:
            app.run_tui()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
