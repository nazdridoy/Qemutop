class QemuTop:
    """Main application orchestrator."""

    def __init__(self, interval: float, use_color: bool, sort_key: str) -> None:
        self.interval = interval
        self.use_color = use_color
        self.sort_key = sort_key
        self.discovery = ProcessDiscovery()
        self.proc_collector = ProcCollector()
        self.net_collector = NetworkCollector()
        self.metrics_engine = MetricsEngine()
        self.host_cpu_monitor = HostCpuMonitor()
        self.hostname = self._get_hostname()
        self.cpu_count = get_host_cpu_count()

    @staticmethod
    def _get_hostname() -> str:
        try:
            return os.uname().nodename
        except Exception:
            return "unknown"

    def collect(self) -> Tuple[List[VMMetrics], Optional[float], int, int]:
        """
        Run one full collection cycle.
        Returns: (vms, host_cpu_pct, host_mem_used_kib, host_mem_total_kib)
        """
        # Refresh network interface counters first
        self.net_collector.refresh_iface_counters()

        pids = self.discovery.discover()
        snapshots: Dict[int, RawSnapshot] = {}

        for pid in pids:
            snap = self.proc_collector.collect(pid, self.net_collector)
            if snap is not None:
                snapshots[pid] = snap

        vms = self.metrics_engine.update(snapshots, self.net_collector)
        host_cpu = self.host_cpu_monitor.sample()
        mem_used, mem_total = get_host_mem()

        return vms, host_cpu, mem_used, mem_total

    def run_once(self, sort_key: str) -> None:
        """Print a single snapshot table to stdout and exit."""
        # Need two samples for rates
        self.collect()
        time.sleep(max(1.0, self.interval))
        vms, host_cpu, mem_used, mem_total = self.collect()
        vms = sort_vms(vms, sort_key, reverse=(sort_key != "name"))

        print(f"qemu-top v{VERSION}  Host: {self.hostname}  "
              f"CPU: {self.cpu_count} cores  "
              f"RAM: {mem_used/1024/1024:.1f}/{mem_total/1024/1024:.1f} GiB")
        print()

        # Header
        hdr = (f"{'NAME':<18} {'PID':>7} {'CPU':>8} {'VCPU':>4} {'RAM':>10} {'CFGMEM':>10} "
               f"{'DISK R':>12} {'DISK W':>12} {'NET RX':>12} {'NET TX':>12} {'UPTIME':>9}")
        print(hdr)
        print("-" * len(hdr))

        for vm in vms:
            dr = fmt_bytes(vm.disk_read_rate).strip() if vm.disk_read_rate is not None else "N/A"
            dw = fmt_bytes(vm.disk_write_rate).strip() if vm.disk_write_rate is not None else "N/A"
            rx = fmt_bytes(vm.net_rx_rate).strip() if vm.net_rx_rate is not None else "N/A"
            tx = fmt_bytes(vm.net_tx_rate).strip() if vm.net_tx_rate is not None else "N/A"
            cpu = fmt_cpu(vm.cpu_pct).strip()
            print(
                f"{vm.name[:18]:<18} {vm.pid:>7} {cpu:>8} {vm.vcpus:>4} {fmt_mem(vm.rss_kib):>10} "
                f"{fmt_mem_mb(vm.configured_mem_mb):>10} "
                f"{dr:>12} {dw:>12} {rx:>12} {tx:>12} {fmt_uptime(vm.uptime_sec):>9}"
            )

        print("-" * len(hdr))
        if vms:
            total_cpu = sum(v.cpu_pct for v in vms if v.cpu_pct is not None)
            total_rss = sum(v.rss_kib for v in vms)
            total_vcpus = sum(v.vcpus for v in vms)
            total_cfgmem = sum(v.configured_mem_mb for v in vms)
            print(
                f"{'TOTAL':<18} {'':>7} {total_cpu:>7.1f}% {total_vcpus:>4} {fmt_mem(total_rss):>10} "
                f"{fmt_mem_mb(total_cfgmem):>10}"
            )

    def run_tui(self) -> None:
        """Launch the curses TUI."""
        curses.wrapper(self._tui_main)

    def _tui_main(self, stdscr) -> None:
        curses.curs_set(0)
        stdscr.nodelay(True)
        stdscr.timeout(200)  # 200ms input poll

        ui = QemuTopUI(stdscr, use_color=self.use_color)
        ui.sort_key = self.sort_key
        ui.interval = self.interval

        last_collect = 0.0
        vms: List[VMMetrics] = []
        host_cpu: Optional[float] = None
        mem_used = 0
        mem_total = 0

        while True:
            now = time.monotonic()

            # Collect data if interval has elapsed
            if now - last_collect >= ui.interval:
                try:
                    vms, host_cpu, mem_used, mem_total = self.collect()
                except Exception:
                    pass  # Never crash the TUI
                last_collect = now
                ui.update(
                    vms, host_cpu, self.cpu_count,
                    mem_used, mem_total,
                    self.hostname, ui.interval,
                )
                ui.render()

            # Handle input
            try:
                key = stdscr.getch()
            except curses.error:
                key = -1

            if key != -1:
                action = ui.handle_input(key)
                if action == "quit":
                    return
                elif action == "refresh":
                    last_collect = 0.0  # Force immediate refresh
                ui.render()


